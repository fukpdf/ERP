{
  "name": "northstar-erp",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "node artifacts/erp-preview/imported/server.js",
    "start": "node artifacts/erp-preview/imported/server.js",
    "build": "tsc --build",
    "lint": "oxlint --deny-warnings packages scripts",
    "typecheck": "tsc --build",
    "test": "node scripts/run-tests.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
