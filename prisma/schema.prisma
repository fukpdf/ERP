generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum TenantStatus { ACTIVE SUSPENDED DISABLED }
enum IdentityStatus { ACTIVE SUSPENDED DISABLED }
model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name String
  status TenantStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  identities TenantIdentity[]
  roles Role[]
  auditEvents AuditEvent[]
  outbox OutboxEvent[]
  organizations Organization[]
  businessUnits BusinessUnit[]
  currencies Currency[]
  unitsOfMeasure UnitOfMeasure[]
  productCategories ProductCategory[]
  products Product[]
  warehouses Warehouse[]
  inventoryStocks InventoryStock[]
  accounts Account[]
  fiscalPeriods FiscalPeriod[]
  journalEntries JournalEntry[]
  journalLines JournalLine[]
  taxCodes TaxCode[]
  vendors Vendor[]
  purchaseOrders PurchaseOrder[]
  purchaseLines PurchaseLine[]
  customers Customer[]
  salesOrders SalesOrder[]
  salesLines SalesLine[]
  employees Employee[]
  payrollRuns PayrollRun[]
  payrollEntries PayrollEntry[]
  leads Lead[]
  opportunities Opportunity[]
  projects Project[]
  projectTasks ProjectTask[]
  billsOfMaterials BillOfMaterials[]
  manufacturingOrders ManufacturingOrder[]
  reportDefinitions ReportDefinition[]
  @@index([status])
}
model Identity {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  status IdentityStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships TenantIdentity[]
  sessions Session[]
}
model TenantIdentity {
  tenantId String @db.Uuid
  identityId String @db.Uuid
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  identity Identity @relation(fields:[identityId],references:[id],onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([tenantId,identityId])
  @@index([identityId])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  identityId String @db.Uuid
  identity Identity @relation(fields:[identityId],references:[id],onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([identityId,expiresAt])
}
model Role {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  bindings RolePermission[]
  @@unique([tenantId,name])
}
model Permission {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  bindings RolePermission[]
}
model RolePermission {
  roleId String @db.Uuid
  permissionId String @db.Uuid
  role Role @relation(fields:[roleId],references:[id],onDelete: Cascade)
  permission Permission @relation(fields:[permissionId],references:[id],onDelete: Cascade)
  @@id([roleId,permissionId])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  actorId String @db.Uuid
  action String
  resourceType String
  resourceId String
  correlationId String
  metadata Json
  occurredAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Restrict)
  @@index([tenantId,occurredAt])
  @@index([tenantId,resourceType,resourceId])
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  eventType String
  dedupeKey String
  aggregateType String
  aggregateId String
  payload Json
  occurredAt DateTime @default(now())
  publishedAt DateTime?
  attempts Int @default(0)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Restrict)
  @@index([publishedAt,occurredAt])
  @@unique([tenantId,dedupeKey])
  @@index([tenantId,occurredAt])
}

// Phase 2 domain foundation
enum RecordStatus { ACTIVE INACTIVE }
enum OrderStatus { DRAFT CONFIRMED CANCELLED COMPLETED }
enum JournalStatus { DRAFT POSTED VOID }
enum EmployeeStatus { ACTIVE ON_LEAVE TERMINATED }
enum PayrollStatus { DRAFT APPROVED PAID }
enum LeadStatus { NEW QUALIFIED CONVERTED LOST }
enum OpportunityStatus { OPEN WON LOST }
enum ProjectStatus { PLANNING ACTIVE ON_HOLD COMPLETED CANCELLED }
enum ManufacturingStatus { PLANNED RELEASED IN_PROGRESS COMPLETED CANCELLED }

model Organization {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  code String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  businessUnits BusinessUnit[]
  @@unique([tenantId,code])
  @@index([tenantId,status])
}
model BusinessUnit {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  organizationId String @db.Uuid
  name String
  code String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete: Cascade)
  warehouses Warehouse[]
  @@unique([tenantId,code])
  @@index([tenantId,organizationId])
}
model Currency {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code String
  name String
  decimalPlaces Int @default(2)
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  @@unique([tenantId,code])
}
model UnitOfMeasure {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code String
  name String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  products Product[]
  @@unique([tenantId,code])
}
model ProductCategory {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  code String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  products Product[]
  @@unique([tenantId,code])
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  categoryId String? @db.Uuid
  uomId String @db.Uuid
  sku String
  name String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  category ProductCategory? @relation(fields:[categoryId],references:[id],onDelete: SetNull)
  uom UnitOfMeasure @relation(fields:[uomId],references:[id],onDelete: Restrict)
  inventoryStocks InventoryStock[]
  purchaseLines PurchaseLine[]
  salesLines SalesLine[]
  billsOfMaterials BillOfMaterials[]
  manufacturingOrders ManufacturingOrder[]
  @@unique([tenantId,sku])
  @@index([tenantId,categoryId])
}
model Warehouse {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  businessUnitId String? @db.Uuid
  code String
  name String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields:[businessUnitId],references:[id],onDelete: SetNull)
  inventoryStocks InventoryStock[]
  @@unique([tenantId,code])
}
model InventoryStock {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  warehouseId String @db.Uuid
  productId String @db.Uuid
  quantity Decimal @default(0) @db.Decimal(20,6)
  reservedQuantity Decimal @default(0) @db.Decimal(20,6)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete: Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete: Restrict)
  @@unique([tenantId,warehouseId,productId])
}
model Account {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code String
  name String
  accountType String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  journalLines JournalLine[]
  @@unique([tenantId,code])
}
model FiscalPeriod {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  startsAt DateTime
  endsAt DateTime
  isClosed Boolean @default(false)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  @@unique([tenantId,name])
  journalEntries JournalEntry[]
  @@index([tenantId,startsAt,endsAt])
}
model JournalEntry {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  fiscalPeriodId String @db.Uuid
  reference String
  status JournalStatus @default(DRAFT)
  entryDate DateTime
  description String?
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  fiscalPeriod FiscalPeriod @relation(fields:[fiscalPeriodId],references:[id],onDelete: Restrict)
  lines JournalLine[]
  @@unique([tenantId,reference])
  @@index([tenantId,entryDate])
}
model JournalLine {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  journalEntryId String @db.Uuid
  accountId String @db.Uuid
  debit Decimal @default(0) @db.Decimal(20,6)
  credit Decimal @default(0) @db.Decimal(20,6)
  description String?
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  journalEntry JournalEntry @relation(fields:[journalEntryId],references:[id],onDelete: Cascade)
  account Account @relation(fields:[accountId],references:[id],onDelete: Restrict)
  @@index([tenantId,journalEntryId])
}
model TaxCode {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code String
  name String
  rate Decimal @db.Decimal(8,4)
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  @@unique([tenantId,code])
}
model Vendor {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code String
  name String
  email String?
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  @@unique([tenantId,code])
}
model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  vendorId String @db.Uuid
  number String
  status OrderStatus @default(DRAFT)
  orderedAt DateTime?
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  vendor Vendor @relation(fields:[vendorId],references:[id],onDelete: Restrict)
  lines PurchaseLine[]
  @@unique([tenantId,number])
  @@index([tenantId,vendorId])
}
model PurchaseLine {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  purchaseOrderId String @db.Uuid
  productId String @db.Uuid
  quantity Decimal @db.Decimal(20,6)
  unitPrice Decimal @db.Decimal(20,6)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId],references:[id],onDelete: Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete: Restrict)
}
model Customer {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code String
  name String
  email String?
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  salesOrders SalesOrder[]
  @@unique([tenantId,code])
}
model SalesOrder {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  customerId String @db.Uuid
  number String
  status OrderStatus @default(DRAFT)
  orderedAt DateTime?
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  customer Customer @relation(fields:[customerId],references:[id],onDelete: Restrict)
  lines SalesLine[]
  @@unique([tenantId,number])
  @@index([tenantId,customerId])
}
model SalesLine {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  salesOrderId String @db.Uuid
  productId String @db.Uuid
  quantity Decimal @db.Decimal(20,6)
  unitPrice Decimal @db.Decimal(20,6)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  salesOrder SalesOrder @relation(fields:[salesOrderId],references:[id],onDelete: Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete: Restrict)
}
model Employee {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  employeeNumber String
  firstName String
  lastName String
  email String?
  status EmployeeStatus @default(ACTIVE)
  hiredAt DateTime
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  payrollEntries PayrollEntry[]
  @@unique([tenantId,employeeNumber])
}
model PayrollRun {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  periodStart DateTime
  periodEnd DateTime
  status PayrollStatus @default(DRAFT)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  entries PayrollEntry[]
  @@unique([tenantId,name])
}
model PayrollEntry {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  payrollRunId String @db.Uuid
  employeeId String @db.Uuid
  gross Decimal @db.Decimal(20,6)
  deductions Decimal @db.Decimal(20,6)
  net Decimal @db.Decimal(20,6)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  payrollRun PayrollRun @relation(fields:[payrollRunId],references:[id],onDelete: Cascade)
  employee Employee @relation(fields:[employeeId],references:[id],onDelete: Restrict)
  @@unique([tenantId,payrollRunId,employeeId])
}
model Lead {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  email String?
  status LeadStatus @default(NEW)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  opportunities Opportunity[]
  @@index([tenantId,status])
}
model Opportunity {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  leadId String? @db.Uuid
  name String
  value Decimal @default(0) @db.Decimal(20,6)
  status OpportunityStatus @default(OPEN)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  lead Lead? @relation(fields:[leadId],references:[id],onDelete: SetNull)
  @@index([tenantId,status])
}
model Project {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code String
  name String
  status ProjectStatus @default(PLANNING)
  startsAt DateTime?
  endsAt DateTime?
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  tasks ProjectTask[]
  @@unique([tenantId,code])
}
model ProjectTask {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  projectId String @db.Uuid
  name String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  project Project @relation(fields:[projectId],references:[id],onDelete: Cascade)
  @@index([tenantId,projectId])
}
model BillOfMaterials {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  productId String @db.Uuid
  version String
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete: Restrict)
  manufacturingOrders ManufacturingOrder[]
  @@unique([tenantId,productId,version])
}
model ManufacturingOrder {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  productId String @db.Uuid
  bomId String @db.Uuid
  number String
  quantity Decimal @db.Decimal(20,6)
  status ManufacturingStatus @default(PLANNED)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete: Restrict)
  bom BillOfMaterials @relation(fields:[bomId],references:[id],onDelete: Restrict)
  @@unique([tenantId,number])
}
model ReportDefinition {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  key String
  name String
  definition Json
  status RecordStatus @default(ACTIVE)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete: Cascade)
  @@unique([tenantId,key])
}
